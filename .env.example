# ── Required for news headlines ───────────────────────────────────────────────
# Sign up free at https://newsapi.org (100 req/day on free tier)
NEWS_API_KEY=your_newsapi_key_here

# ── Required for commodity prices ─────────────────────────────────────────────
# Sign up free at https://financialmodelingprep.com (250 req/day on free tier)
FMP_API_KEY=your_fmp_key_here

# ── Required for AI summaries, deal extraction, opportunity scoring ────────────
# Get from https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Optional: adds YouTube video view signals to Consumer Trends ───────────────
# Get from https://console.cloud.google.com → APIs → YouTube Data API v3
# Free tier: 10,000 units/day
GOOGLE_API_KEY=your_google_api_key_here

# ── Future: Amazon best-seller rankings ───────────────────────────────────────
# Requires an Amazon Associates affiliate account
# https://affiliate-program.amazon.com → then request PA API 5.0 access
# AMAZON_PA_KEY=your_amazon_pa_key_here
# AMAZON_ASSOCIATE_TAG=your_associate_tag

# ── Notes on Instagram & Facebook ─────────────────────────────────────────────
# Meta's Graph API only returns insights for pages/accounts YOU OWN and manage.
# It cannot pull general platform-wide trend data without owning those accounts.
# If you manage brand pages, add:
# META_ACCESS_TOKEN=your_page_access_token
# META_PAGE_IDS=page_id_1,page_id_2

# ── Server port (optional, defaults to 3001) ──────────────────────────────────
# PORT=3001
