# ── News ─────────────────────────────────────────────────────────────────────
# Sign up free at https://newsapi.org → "Get API Key"
# Free tier: 100 requests/day — powers the News panel
NEWS_API_KEY=your_newsapi_key_here

# ── Commodity Prices ──────────────────────────────────────────────────────────
# Sign up free at https://financialmodelingprep.com/developer/docs
# Free tier: 250 requests/day — powers the Commodity Prices section
FMP_API_KEY=your_fmp_key_here

# ── AI Summaries, Deal Extraction & Opportunity Scoring ───────────────────────
# Get your key at https://console.anthropic.com
# Powers: news AI summaries, deal extraction, opportunity scoring in AI Insights
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Social Buzz (YouTube trends) ──────────────────────────────────────────────
# console.cloud.google.com → Enable "YouTube Data API v3" → Create credentials
# Free tier: 10,000 units/day — powers the Social Media Buzz panel
GOOGLE_API_KEY=your_google_api_key_here

# ── Server ────────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
